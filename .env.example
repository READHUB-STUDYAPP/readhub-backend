# ==============================================================================
# ReadHub Backend — Environment Variables
# Copy to `.env` and fill in real values. NEVER commit the real .env file.
# ==============================================================================

# --- Server ---
# Port the Express server listens on (nginx will reverse-proxy to this)
PORT=5000
# "production" on the VPS. Controls secure cookie flag (refreshToken cookie).
NODE_ENV=production

# --- Database (managed MongoDB on a separate DB server) ---
# Connection string to the external/managed Mongo instance (not on the app host).
# Include auth + db name. Use TLS for the managed endpoint where required.
# Example (managed host):   mongodb://readhub_app:STRONG_PASSWORD@db.internal.example.com:27017/readhub?authSource=admin&tls=true
# Example (SRV/Atlas-like): mongodb+srv://readhub_app:STRONG_PASSWORD@cluster.example.com/readhub?retryWrites=true&w=majority
MONGODB_URI=mongodb://USER:PASSWORD@DB_HOST:27017/readhub?authSource=admin

# --- CORS allowed origins ---
# Exact origins (scheme + host, NO trailing slash) allowed to call the API.
FRONTEND_URL=https://app.readhub.example.com
WAITLIST_URL=https://readhub.example.com
# Local dev origin (e.g. http://localhost:5173). Leave blank in production.
DEVELOPMENT_TEST=

# --- JWT / Auth ---
# Long random secrets. Generate with:  openssl rand -hex 64
ACCESS_TOKEN_SECRET=CHANGE_ME_long_random_secret_1
REFRESH_TOKEN_SECRET=CHANGE_ME_long_random_secret_2
# Access token lifetime, e.g. 15m, 1h, 7d
JWT_EXPIRES_IN=15m

# --- Cloudinary (book files + cover/profile images) ---

# --- Resend (transactional email: verification codes, admin invites) ---
RESEND_API_KEY=your_resend_api_key
# Verified sender in Resend — a bare address (no-reply@readhub.study) or "Name <addr>".
# The domain must be verified in Resend, or use onboarding@resend.dev for testing.
EMAIL_FROM=no-reply@readhub.study

# --- Google OAuth ---
# OAuth 2.0 Client ID (must match the frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# --- Swagger / API docs ---
# Public base URL of this API, shown as the server in /api-docs (no trailing slash)
SWAGGER_SERVER_URL=https://api.readhub.example.com

# --- Object storage (MinIO / S3-compatible) � replaces Cloudinary ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=readhub_minio
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=readhub
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Public delivery base (bucket is public-read); object URLs = <S3_PUBLIC_URL>/<bucket>/<key>
S3_PUBLIC_URL=https://files.readhub.study

# --- Admin / RBAC ---
# Initial admin seeded directly into the DB via `npm run seed:admin`.
SEED_ADMIN_EMAIL=admin@readhub.study
SEED_ADMIN_PASSWORD=CHANGE_ME_strong_password
SEED_ADMIN_USERNAME=readhub-admin
# Base URL of the admin app used to build invite accept links
# (falls back to FRONTEND_URL). Link = <ADMIN_APP_URL>/admin/accept-invite?token=...
ADMIN_APP_URL=https://admin.readhub.study
# Days an admin invitation stays valid (default 3)
ADMIN_INVITE_TTL_DAYS=3

# --- Google Sign-In: mobile OAuth clients ---
# A Google ID token carries the client id it was issued for in `aud`. The
# Android and iOS apps use their own OAuth clients, so verifying only against
# the web client id rejects every mobile sign-in with "Wrong recipient".
# Both are OPTIONAL: leave blank and behaviour is unchanged (web only).
#
# Create these in Google Cloud Console -> Credentials -> OAuth client ID:
#   Android : needs the package name (study.readhub.app) and the signing SHA-1
#   iOS     : needs the bundle identifier (study.readhub.app)
#
# Note: if the mobile app is configured with the WEB client id as its
# `webClientId`, the token it returns already carries the web `aud` and these
# are not required. They are here so either integration works.
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_ID_IOS=

